# OCI Accelerator configuration
#
# Created by `oci-accelerator init` or copied from .env.example.
# Load it with: oci-accelerator --env-file .env
# The proxy never reads .env unless you pass --env-file.
# Environment variables override this file, even when set to an empty value.
# For Docker and Compose, use .env.container-example instead.
#
# Values:
#   durations  500ms, 30s, 10m, 1h
#   numbers    plain integers, no units or separators
#   booleans   true or false
#   lists      comma-separated, such as a.example,b.example
#   paths      relative to the working directory, not this file
#
# Values below are the built-in defaults unless marked as examples.

# ── Required ─────────────────────────────────────────────────────────

# Registries to intercept and cache, as host or host:port (port 443 if
# omitted). Docker Hub is registry-1.docker.io. Example value.
OCI_ACCELERATOR_REGISTRIES=registry-1.docker.io,ghcr.io,public.ecr.aws

# Private, persistent directory for the CA that signs intercepted
# connections. Clients must trust its certificate. Example path.
OCI_ACCELERATOR_CA_DIR=./data/ca

# Private, persistent directory for cached content. It must be separate
# from the CA directory. Example path.
OCI_ACCELERATOR_CACHE_DIR=./data/cache

# ── Proxy ────────────────────────────────────────────────────────────

# Address Docker connects to as its HTTPS proxy. Keep it on loopback or
# a trusted private interface. Empty or 0.0.0.0 listens on every
# interface.
OCI_ACCELERATOR_LISTEN=127.0.0.1:5128

# ── Peering (optional) ───────────────────────────────────────────────

# Instances can download cached content from each other before falling
# back to the registry. Peers authenticate with mutual TLS using the
# shared CA, so give every instance the same ca.crt and ca.key.
# Registry credentials and approvals are never shared.

# Address for the peer listener, separate from the proxy and metrics
# listeners. Empty disables peering. Setting it enables peering.
#
# Example: 0.0.0.0:5130
OCI_ACCELERATOR_PEER_LISTEN=

# This instance's address as other peers reach it. Required when peering
# is enabled. Each instance needs its own address, not a load balancer.
#
# Example: accelerator-a.example:5130
OCI_ACCELERATOR_PEER_ADVERTISE=

# Other instances to contact at startup, as host:port. Optional: an
# instance with no seeds waits for another peer to contact it.
#
# Example: accelerator-b.example:5130,accelerator-c.example:5130
OCI_ACCELERATOR_PEER_SEEDS=

# Private, persistent directory for this instance's peer identity and
# address book. Required when peering is enabled. It must be separate
# from the CA and cache directories. Example path.
OCI_ACCELERATOR_PEER_STATE_DIR=./data/peers

# ── Peering (Hints) ──────────────────────────────────────────────────

# Each instance polls its peers for hints about which peer caches what.
# These settings apply only when peering is enabled.

# Time limit for one poll of a peer.
OCI_ACCELERATOR_PEER_HINT_REFRESH_TIMEOUT=1m

# Delay between polls of each peer, with +/-20% jitter. At least 1s.
OCI_ACCELERATOR_PEER_HINT_REFRESH_INTERVAL=1m

# Interval between full re-reads of each peer's cache listing, with
# +/-20% jitter. At least 1s.
OCI_ACCELERATOR_PEER_HINT_FULL_REFRESH_INTERVAL=1h

# ── Metrics (optional) ───────────────────────────────────────────────

# Address for the metrics and health endpoints: /metrics (Prometheus),
# /livez and /readyz. Empty disables them. Must be a loopback IP unless
# METRICS_ALLOW_REMOTE is true.
#
# Example: 127.0.0.1:9090
OCI_ACCELERATOR_METRICS_LISTEN=

# Allow METRICS_LISTEN to bind a non-loopback address. The endpoints
# have no authentication, so expose them only on a private network.
OCI_ACCELERATOR_METRICS_ALLOW_REMOTE=false

# ── Registry redirects ───────────────────────────────────────────────

# Private storage hosts that registries may redirect downloads to, as
# host or host:port. Public hosts need no entry. Empty allows only
# public hosts and configured registries.
#
# Example: storage.internal.example,blobs.internal.example:8443
OCI_ACCELERATOR_REDIRECT_ALLOWLIST=

# ── Cache (Storage) ──────────────────────────────────────────────────

# Maximum cache size in bytes, including downloads in progress and 4 KiB
# of metadata per entry. Leave disk headroom for filesystem overhead.
# 34359738368 is 32 GiB.
OCI_ACCELERATOR_CACHE_MAX_BYTES=34359738368

# Maximum number of cached entries, including downloads in progress.
# Each entry uses memory for its index record.
OCI_ACCELERATOR_CACHE_MAX_ENTRIES=100000

# Maximum downloads written to the cache at once. Further cache misses
# still reach Docker but are not cached.
OCI_ACCELERATOR_CACHE_MAX_FILLS=16

# Time limit for one cache download, from origin or a peer. A resumed
# (ranged) download keeps filling after Docker disconnects, up to this
# limit.
OCI_ACCELERATOR_CACHE_FILL_TIMEOUT=10m

# How long a request waits for another request already downloading the
# same item, before downloading it again itself. 0s disables waiting.
OCI_ACCELERATOR_CACHE_FILL_WAIT_TIMEOUT=1s

# ── Cache (Mutable) ──────────────────────────────────────────────────

# Tag manifests, tag lists, referrer lists and catalog responses can
# change upstream, so the proxy reuses them only briefly.

# How long to reuse a mutable response before asking upstream again.
# 0s disables mutable response caching.
OCI_ACCELERATOR_CACHE_MUTABLE_TTL=30s

# Share cached tag and referrer responses between different Bearer
# tokens that the registry approved for the same repository. false
# reuses a response only for an identical request.
OCI_ACCELERATOR_CACHE_MUTABLE_SHARED=true

# ── Cache (Authorization) ────────────────────────────────────────────

# The registry must approve a request before the proxy serves cached
# content. These settings let the proxy reuse a recent approval instead
# of asking again. Approvals and tokens are never shared with peers.

# How long to reuse an approval for a request with an Authorization
# header. Revoked tokens can keep working from cache for this long.
# 0s asks the registry every time.
OCI_ACCELERATOR_CACHE_AUTHORIZATION_TTL=30s

# How long to reuse an approval for a request without credentials. A
# repository made private can stay readable from cache for this long.
# 0s asks the registry every time.
OCI_ACCELERATOR_CACHE_ANONYMOUS_AUTHORIZATION_TTL=15m

# Maximum approvals held in memory, across both kinds.
OCI_ACCELERATOR_CACHE_MAX_AUTHORIZATION_ENTRIES=10000

# ── Connections and limits ───────────────────────────────────────────

# Time limit for opening a TCP connection to a registry or storage host.
OCI_ACCELERATOR_DIAL_TIMEOUT=10s

# Time limit for the TLS handshake with a registry or storage host.
OCI_ACCELERATOR_TLS_HANDSHAKE_TIMEOUT=10s

# Time limit for a registry to start responding after a request is sent.
# Also limits how long Docker can take to send request headers.
OCI_ACCELERATOR_RESPONSE_HEADER_TIMEOUT=30s

# Closes a connection or tunnel after no data moves for this long.
OCI_ACCELERATOR_IDLE_TIMEOUT=2m

# How long to let active requests finish after SIGINT or SIGTERM before
# closing them. Keep a container stop timeout longer than this.
OCI_ACCELERATOR_SHUTDOWN_TIMEOUT=15s

# Maximum open client connections. Further connections wait until one
# closes.
OCI_ACCELERATOR_MAX_CONNECTIONS=256

# Maximum intercepted-site certificates kept in memory. Least recently
# used certificates are evicted and re-signed when needed.
OCI_ACCELERATOR_MAX_LEAF_CERTIFICATES=256
