# Copy to .env and pass --env-file .env. The binary never loads .env implicitly.
# Process environment values override this file, including explicit empty values.
# Paths are relative to the working directory, not this file's directory.

# Required settings have no built-in defaults. These are native-deployment examples.
OCI_ACCELERATOR_REGISTRIES=registry-1.docker.io,ghcr.io,public.ecr.aws
OCI_ACCELERATOR_CA_DIR=./data/ca
OCI_ACCELERATOR_CACHE_DIR=./data/cache

# All remaining values match the built-in defaults.
OCI_ACCELERATOR_LISTEN=127.0.0.1:3128
# Metrics are disabled by default. Remote metrics require explicit opt-in.
OCI_ACCELERATOR_METRICS_LISTEN=
OCI_ACCELERATOR_METRICS_ALLOW_REMOTE=false
# Optional private HTTPS storage authorities. Comma-separated, like REGISTRIES.
OCI_ACCELERATOR_REDIRECT_ALLOWLIST=

# Cache limits include in-progress reservations.
OCI_ACCELERATOR_CACHE_MAX_BYTES=34359738368
OCI_ACCELERATOR_CACHE_MAX_FILLS=16
OCI_ACCELERATOR_CACHE_MAX_ENTRIES=100000
OCI_ACCELERATOR_CACHE_FILL_TIMEOUT=10m
# 0s disables waiting for another fill.
OCI_ACCELERATOR_CACHE_FILL_WAIT_TIMEOUT=1s
# Separate upstream approval windows for requests with and without Authorization.
# 0s disables the corresponding class of approval grants.
OCI_ACCELERATOR_CACHE_AUTHORIZATION_TTL=30s
OCI_ACCELERATOR_CACHE_ANONYMOUS_AUTHORIZATION_TTL=15m
OCI_ACCELERATOR_CACHE_MAX_AUTHORIZATION_ENTRIES=10000

OCI_ACCELERATOR_DIAL_TIMEOUT=10s
OCI_ACCELERATOR_TLS_HANDSHAKE_TIMEOUT=10s
OCI_ACCELERATOR_RESPONSE_HEADER_TIMEOUT=30s
OCI_ACCELERATOR_IDLE_TIMEOUT=2m
OCI_ACCELERATOR_SHUTDOWN_TIMEOUT=15s
OCI_ACCELERATOR_MAX_CONNECTIONS=256
OCI_ACCELERATOR_MAX_LEAF_CERTIFICATES=256

# For Docker/Compose, edit these four values above before starting:
# OCI_ACCELERATOR_LISTEN=0.0.0.0:3128
# OCI_ACCELERATOR_METRICS_LISTEN=127.0.0.1:9090
# OCI_ACCELERATOR_CA_DIR=/var/lib/oci-accelerator/ca
# OCI_ACCELERATOR_CACHE_DIR=/var/lib/oci-accelerator/cache
# Keep metrics on container loopback for the image healthcheck.
