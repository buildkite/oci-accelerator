# Copy to .env.container for Compose or docker run --env-file.
# Docker reads this file, not the application, so keep to unquoted KEY=value lines.
# Values here override the image defaults.
# See .env.example for every other setting and its default.

OCI_ACCELERATOR_REGISTRIES=registry-1.docker.io,ghcr.io,public.ecr.aws

# The proxy binds all container interfaces so the published port works.
# Publish it only on a trusted address, such as 127.0.0.1.
OCI_ACCELERATOR_LISTEN=0.0.0.0:3128

# Required by the image healthcheck. Do not publish this port.
OCI_ACCELERATOR_METRICS_LISTEN=127.0.0.1:9090

OCI_ACCELERATOR_CA_DIR=/var/lib/oci-accelerator/ca
OCI_ACCELERATOR_CACHE_DIR=/var/lib/oci-accelerator/cache

# Peering is disabled unless you configure its listener, advertised address, and state dir.
# Positive hint timings retain their defaults even when peering is disabled.
OCI_ACCELERATOR_PEER_HINT_REFRESH_TIMEOUT=1m
OCI_ACCELERATOR_PEER_HINT_REFRESH_INTERVAL=1m
OCI_ACCELERATOR_PEER_HINT_FULL_REFRESH_INTERVAL=1h
